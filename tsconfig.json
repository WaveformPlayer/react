{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		// The examples import the published sub-paths; point them at src so
		// typechecking doesn't need a build. (No `baseUrl`: TS 7 removed it, and
		// `paths` resolve relative to this file without it.)
		"paths": {
			"@arraypress/waveform-react/player": ["./src/player/index.ts"],
			"@arraypress/waveform-react/bar": ["./src/bar/index.ts"],
			"@arraypress/waveform-react/playlist": ["./src/playlist/index.ts"],
			"@arraypress/waveform-react/sounds": ["./src/sounds/index.ts"]
		},
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"declaration": true,
		"emitDeclarationOnly": false,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*", "test/**/*", "examples/**/*"],
	"exclude": ["node_modules", "dist"]
}
